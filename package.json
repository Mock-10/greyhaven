{
  "name": "greyhaven",
  "private": true,
  "version": "0.0.0",
  "description": "Double Life: an isometric pixel-art life sim and crime sandbox for the browser.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check src tests e2e tools \"*.{ts,json}\" .github",
    "format": "prettier --write src tests e2e tools \"*.{ts,json}\" .github",
    "shots": "node tools/shots.ts",
    "compare": "python3 -I tools/compare_reference.py"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.18.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
